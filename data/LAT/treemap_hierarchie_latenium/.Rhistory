setwd("~/Memoire_RM/dataviz/LAT/treemap_hierarchie_latenium")
library(dplyr)
library(stringr)
library(readxl)
library(ggplot2)
library(treemapify)
library(tidyr)
# --------------------------------------------------------------------------
# 1. CHARGEMENT ET NETTOYAGE DES DONNÉES
# --------------------------------------------------------------------------
df <- read_excel("df_inventaire_photos_lat.xlsx")
# L'ordre exact des thèmes tel que demandé
levels_themes <- c(
"100", "101", "102", "104", "105", "110", "111", "112",
"113", "114", "115", "150", "151", "120", "Autres codes"
)
df_clean <- df %>%
rename(code_brut = code_designation) %>%
tidyr::extract(
code_brut,
into = c("commune", "site", "theme_principal"),
regex = "^([^-]+)-([^-]+)-(\\d{3})",
remove = FALSE
) %>%
filter(!is.na(commune) & !is.na(site) & !is.na(theme_principal)) %>%
mutate(across(c(commune, site, theme_principal), str_trim)) %>%
# Regroupement des codes d'expositions et musées sous LAT (Laténium)
mutate(commune = if_else(commune %in% c("EXP", "MUS", "EXPO"), "LAT", commune)) %>%
filter(commune != "" & site != "" & theme_principal != "") %>%
filter(commune != "NA" & site != "NA") %>%
# On classe le thème uniquement pour la structure/l'ordre
mutate(theme_groupe = if_else(theme_principal %in% levels_themes, theme_principal, "Autres codes")) %>%
mutate(theme_groupe = factor(theme_groupe, levels = levels_themes))
# --------------------------------------------------------------------------
# 2. AGRÉGATION
# --------------------------------------------------------------------------
df_plot <- df_clean %>%
# On s'assure que la colonne est numérique
mutate(diapositives = suppressWarnings(as.numeric(diapositives))) %>%
# SOLUTION BRUIT : On groupe directement par commune et par site
group_by(commune, site) %>%
summarise(diapos_site = sum(diapositives, na.rm = TRUE), .groups = "drop") %>%
# Filtre : sites avec au moins 50 diapos
filter(diapos_site >= 50) %>%
# Création des échelles catégorielles demandées (sur le total du site)
mutate(categorie_diapos = cut(
diapos_site,
breaks = c(49, 200, 400, 800, 1000, 5000, 8000, 10000, Inf),
labels = c("50 à 200", "201 à 400", "401 à 800", "801 à 1 000", "1 001 à 5 000", "5 001 à 8 000", "8 001 à 10 000", "> 10 000"),
right = TRUE
)) %>%
# Couleur de texte dynamique (Noir sur jaune/vert clair, Blanc sur bleu/violet sombre)
mutate(text_color = if_else(
categorie_diapos %in% c("50 à 200", "201 à 400", "401 à 800", "801 à 1 000"),
"grey20", "white"
)) %>%
# On trie explicitement par commune, puis par quantité décroissante
arrange(commune, desc(diapos_site))
# --------------------------------------------------------------------------
# 3. VISUALISATION (TREEMAP)
# --------------------------------------------------------------------------
p_treemap <- ggplot(df_plot, aes(
area = diapos_site,
fill = categorie_diapos,
subgroup = commune,
# Label du site (nom uniquement)
label = site
)) +
# Tuiles de base = les sites
# On ajoute alpha = 0.85 pour rendre les couleurs moins 'pétantes'
geom_treemap(color = "white", size = 1.2, alpha = 0.85) +
# Niveau 1 : Communes (Bordures pour bien les délimiter)
geom_treemap_subgroup_border(colour = "black", size = 2.5) +
geom_treemap_subgroup_text(
place = "centre", grow = TRUE, alpha = 0.3,
colour = "black", fontface = "bold"
) +
# Niveau 2 : Sites (Texte principal avec couleur dynamique)
geom_treemap_text(
aes(colour = text_color),
place = "topleft", alpha = 1,
size = 11, fontface = "bold.italic",
reflow = TRUE,
min.size = 0 # Force l'affichage du texte même si c'est un peu serré
) +
# Appliquer les couleurs de texte telles quelles
scale_colour_identity() +
# Echelle de couleur discrète (par catégories)
scale_fill_viridis_d(
option = "viridis",
direction = -1, # Les plus grandes quantités en plus foncé
name = "Poids documentaire par\nsite archéologique",
drop = FALSE # Garder toutes les catégories dans la légende même si vides
) +
# Titres et légende
labs(
title = "Hiérarchie spatiale des fonds de la Diathèque : des communes aux sites de fouilles.",
subtitle = "Distribution du volume de diapositives par unité topographique (Total : 170 502 unités).",
caption = "Données : Inventaire de la Diathèque - Laténium Parc et Musée d'Archéologie.\nPériode : 1960 - 2005"
) +
theme_minimal() +
theme(
legend.position = "right",
legend.title = element_text(face = "bold", size = 10),
plot.title = element_text(face = "bold", size = 16, hjust = 0.5),
plot.subtitle = element_text(size = 12, hjust = 0.5),
plot.caption = element_text(size = 10, hjust = 1, colour = "grey30"),
plot.margin = margin(1, 1, 1, 1, "cm")
)
# Affichage du graphique
print(p_treemap)
# Sauvegarde de l'image
ggsave("treemap_hierarchie_spaciale_latenium.png", plot = p_treemap, width = 12, height = 9, dpi = 300, bg = "white")
ggsave("treemap_hierarchie_spaciale_latenium.svg", plot = p_treemap, width = 12, height = 9, dpi = 300, bg = "white")

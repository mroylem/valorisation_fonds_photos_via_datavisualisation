# Chargement des bibliothèques nécessaires
library(readxl)
library(dplyr)
library(sf)
library(rnaturalearth)
library(rnaturalearthdata)
library(ggplot2)
library(ggrepel)
library(ggspatial)
library(stringr)
library(RColorBrewer)
# Répertoire de travail
base_dir <- "C:/Users/raiku/Documents/Memoire_RM/dataviz/BPUN/cartographie_photo_SNG"
setwd(base_dir)
# ------------------------------------------------------------------------------
# 1. Lecture et nettoyage des données Excel
# ------------------------------------------------------------------------------
excel_file <- "df_fonds_sng.xlsx"
df <- read_excel(excel_file)
# Nettoyage de la colonne 'pays' : suppression des espaces insécables et blancs en trop
df_clean <- df %>%
mutate(
pays_clean = str_trim(pays),
pays_clean = gsub("\u00A0", "", pays_clean),
pays_clean = str_trim(pays_clean),
volume_photographie = suppressWarnings(as.numeric(volume_photographie))
) %>%
filter(!is.na(pays_clean) & !is.na(volume_photographie) & volume_photographie > 0)
# Dictionnaire de correspondance des noms de pays (Excel -> name_fr de rnaturalearth)
country_mapping <- c(
"Afrique australe"   = "Afrique du Sud",
"Amérique du Nord"   = "États-Unis",
"Amérique du Sud"    = "Brésil",
"Argentine"          = "Argentine",
"Australie"          = "Australie",
"Bosnie-Herzégovine" = "Bosnie-Herzégovine",
"Brésil"             = "Brésil",
"Bénin"              = "Bénin",
"Canada"             = "Canada",
"Costa Rica"         = "Costa Rica",
"Crimée"             = "Ukraine",
"Croatie"            = "Croatie",
"Egypte"             = "Égypte",
"Espagne"            = "Espagne",
"Europe du Nord"     = "Norvège",
"France"             = "France",
"Ghana"              = "Ghana",
"Grèce"              = "Grèce",
"Géorgie"            = "Géorgie",
"Inde"               = "Inde",
"Indonésie"          = "Indonésie",
"Italie"             = "Italie",
"Japon"              = "Japon",
"Lesotho"            = "Lesotho",
"Madagascar"         = "Madagascar",
"Mexique"            = "Mexique",
"Monaco"             = "Monaco",
"Mongolie"           = "Mongolie",
"Mozambique"         = "Mozambique",
"Neuchâtel"          = "Suisse",
"Nouvelle-Calédonie" = "Nouvelle-Calédonie",
"Ouzbékistan"        = "Ouzbékistan",
"Paraguay"           = "Paraguay",
"Pologne"            = "Pologne",
"Portugal"           = "Portugal",
"Pérou"              = "Pérou",
"Roumanie"           = "Roumanie",
"Royaume-Uni"        = "Royaume-Uni",
"Russie"             = "Russie",
"Suisse"             = "Suisse",
"Surinam"            = "Suriname",
"Tibet"              = "République populaire de Chine",
"Turkménistan"       = "Turkménistan",
"Turquie"            = "Turquie",
"USA"                = "États-Unis",
"Uruguay"            = "Uruguay"
)
# Application de la correspondance et agrégation des volumes de photos par pays
df_agg <- df_clean %>%
mutate(pays_map = country_mapping[pays_clean]) %>%
filter(!is.na(pays_map)) %>%
group_by(pays_map) %>%
summarise(
total_photos = sum(volume_photographie, na.rm = TRUE),
.groups = "drop"
)
# ------------------------------------------------------------------------------
# 2. Préparation du fond de carte et jointures spatiales
# ------------------------------------------------------------------------------
# Importation des frontières mondiales moyenne résolution (1:50m)
world <- ne_countries(scale = "medium", returnclass = "sf")
# Exclusion de l'Antarctique pour optimiser l'espace visuel de la carte
world <- world %>% filter(continent != "Antarctica")
# Jointure du volume de photos avec le shapefile (via name_fr, les noms en français)
world_mapped <- world %>%
left_join(df_agg, by = c("name_fr" = "pays_map"))
# Extraction des centroïdes officiels optimisés de Natural Earth (label_x, label_y)
# pour les pays concernés afin de placer nos points et étiquettes
centroids_sf <- world_mapped %>%
st_drop_geometry() %>%
filter(!is.na(total_photos)) %>%
st_as_sf(coords = c("label_x", "label_y"), crs = 4326, remove = FALSE)
# ------------------------------------------------------------------------------
# 3. Projection Cartographique (Système Robinson)
# ------------------------------------------------------------------------------
# Application de la projection Robinson (+proj=robin) aux pays et aux points
world_proj <- st_transform(world_mapped, crs = "+proj=robin")
centroids_proj <- st_transform(centroids_sf, crs = "+proj=robin")
# Extraction des coordonnées projetées X et Y en mètres pour l'affichage de ggrepel
coords <- st_coordinates(centroids_proj)
centroids_proj$X <- coords[, 1]
centroids_proj$Y <- coords[, 2]
# ------------------------------------------------------------------------------
# 4. Rendu de la carte avec ggplot2
# ------------------------------------------------------------------------------
p_map <- ggplot(data = world_proj) +
# 1. Tracé de fond : Tous les pays du monde en gris neutre
geom_sf(fill = "#f1f5f9", colour = "#cbd5e1", linewidth = 0.2) +
# 2. Tracé thématique : Coloration des pays mentionnés (choroplèthe)
# Utilisation d'une échelle logarithmique car la France (474) domine largement
geom_sf(
data = world_proj %>% filter(!is.na(total_photos)),
aes(fill = total_photos),
colour = "#94a3b8",
linewidth = 0.2
) +
# 3. Échelle de couleur personnalisée (dégradé de bleu de RColorBrewer)
scale_fill_gradientn(
colors = c("#dbeafe", "#60a5fa", "#1d4ed8", "#1e3a8a"),
trans = "log10",
breaks = c(1, 5, 10, 50, 100, 500),
labels = c("1", "5", "10", "50", "100", "500"),
name = "Volume de photos",
guide = guide_colorbar(
direction = "horizontal",
barwidth = 15,
barheight = 0.5,
title.position = "top",
title.theme = element_text(face = "bold", size = 10, colour = "#1e293b"),
label.theme = element_text(size = 8, colour = "#475569")
)
) +
# 4. Ajout des marqueurs ponctuels (petits cercles rouges) sur les pays
geom_point(
data = centroids_proj,
aes(x = X, y = Y),
color = "#e11d48", # Rose-600 (contraste rouge très élégant)
size = 1, # Taille réduite de 2 à 1
alpha = 0.85
) +
# 5. Ajout des étiquettes (badges) avec le nombre de photographies
# ggrepel repousse automatiquement les badges pour éviter les chevauchements
geom_label_repel(
data = centroids_proj,
aes(x = X, y = Y, label = total_photos),
fill = "#1e293b", # Fond ardoise foncé moderne
color = "white", # Texte en blanc
fontface = "bold",
size = 2.2, # Taille réduite de 2.8 à 2.2 pour la lisibilité
label.padding = unit(0.12, "lines"),
box.padding = unit(0.2, "lines"),
point.padding = unit(0.15, "lines"),
segment.color = "black", # Ligne de liaison noire pour plus de visibilité
segment.size = 0.3,
min.segment.length = 0, # Toujours dessiner la ligne reliant le point et le badge
force = 1.2,
max.overlaps = 50
) +
# 6. Éléments d'échelle cartographique et rose des vents
annotation_north_arrow(
location = "tr",
which_north = "grid",
pad_x = unit(0.25, "in"),
pad_y = unit(1.2, "in"),
style = north_arrow_minimal(
line_col = "#475569",
text_col = "#475569"
)
) +
# 7. Ajustement des limites de coordonnées (zoom sur les continents en coupant l'océan Pacifique)
coord_sf(
xlim = c(-12500000, 16000000),
ylim = c(-6200000, 8300000),
expand = FALSE
) +
# 8. Thème et mise en page épurée (theme_void supprime axes et grille)
theme_void(base_size = 12) +
theme(
text = element_text(family = "sans"),
plot.margin = margin(20, 20, 20, 20),
plot.title.position = "plot",
plot.caption.position = "plot", # Alignement de la caption par rapport au plot entier
plot.title = element_text(face = "bold", size = 15, colour = "#0f172a", margin = margin(b = 5)),
plot.subtitle = element_text(size = 10.5, colour = "#475569", margin = margin(b = 20)),
plot.caption = element_text(size = 8, colour = "#64748b", margin = margin(t = 15), hjust = 1), # Alignement à droite
# Positionnement de la légende en bas au centre
legend.position = "bottom",
legend.box = "horizontal",
legend.margin = margin(t = 10)
) +
# Libellés des titres et légendes
labs(
title = "Répartition géographique des dossiers photographiques -\nFonds SNG (1869-1931)", # Bornes chronologiques
subtitle = "Chaque pays mentionné est coloré selon son volume de photographies. Les points rouges marquent leur position\net les badges indiquent le nombre exact d'images concernées.",
caption = "Données : Recensement des objets photographiques (Base de données Flora)\nBibliothèque publique et universitaire de Neuchâtel\nNote : Les zones régionales historiques ont été rattachées aux pays modernes correspondants\n(ex. Tibet -> Chine, Crimée -> Ukraine)."
)
# ------------------------------------------------------------------------------
# 5. Sauvegarde de la visualisation au format JPEG et SVG haute résolution
# ------------------------------------------------------------------------------
output_filename <- "cartographie_fonds_SNG.jpeg"
ggsave(output_filename,
plot = p_map,
width = 9.8,
height = 6.0,
dpi = 300,
bg = "white"
)
output_filename <- "cartographie_fonds_SNG.svg"
ggsave(output_filename,
plot = p_map,
width = 9.8,
height = 6.0,
dpi = 300,
bg = "white"
)
